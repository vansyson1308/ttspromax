# Environment Variables Example
# Copy this file to .env.local for development.
# Never commit actual API keys to version control.

# MakeVoice.io API key (optional, for ElevenLabs voices via MakeVoice proxy)
# Without this, only Edge TTS + ONNX Vietnamese voices are available.
# MAKEVOICE_API_KEY=your_makevoice_api_key_here

# TikTok TTS proxy URL (optional, for fun TikTok voices in Pet News)
# Defaults to the public weilnet workers proxy if unset.
# TIKTOK_TTS_PROXY=https://tiktok-tts.weilnet.workers.dev/api/generation

# Fish Audio cloud voice cloning (optional).
# Use a personal key and never commit the real value.
# FISH_API_KEY=your_fish_audio_api_key_here

# Gemini TTS — premium, context-aware Vietnamese/English voices (optional).
# Top-ranked for Vietnamese in blind preference tests (Sept 2026).
# Get a key at https://aistudio.google.com/apikey. Enables "PREMIUM AI" voices.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Edge TTS tuning (optional).
# Max simultaneous WebSocket connections per server process (default 6).
# EDGE_TTS_CONCURRENCY=6
# In-memory sentence cache size in MB (default 64).
# EDGE_TTS_CACHE_MB=64

# Next.js
NEXT_TELEMETRY_DISABLED=1
